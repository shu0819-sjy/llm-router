# Copy to .env and fill in. Do not commit .env.

LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=8000
LLM_ROUTER_DB_PATH=./data/llm_router.db

# Runtime mode: production (default) | development | test
# Outside development/test, empty or placeholder admin tokens are rejected at startup.
LLM_ROUTER_ENV=development

# REQUIRED outside development: set a strong unique value (do not ship the placeholder).
# Production policy: >= LLM_ROUTER_ADMIN_TOKEN_MIN_LENGTH (default 24), mixed character
# classes (at least 3 of lower/upper/digit/symbol), not a well-known placeholder.
# In development, the placeholder below is accepted so local uvicorn works out of the box.
LLM_ROUTER_ADMIN_TOKEN=change-me-admin-token
LLM_ROUTER_ADMIN_TOKEN_MIN_LENGTH=24

# Optional HMAC secret for rate-limit bucket digests (avoids raw API keys as limiter IDs).
# If unset, a process-local secret is derived. Set explicitly for multi-instance deployments.
LLM_ROUTER_RATE_LIMIT_SECRET=

# Request boundary limits (RequestBoundaryMiddleware) — OpenAI-shaped 413/400/429.
LLM_ROUTER_MAX_BODY_BYTES=2097152
LLM_ROUTER_MAX_MESSAGES=512
LLM_ROUTER_MAX_TOOLS=64
LLM_ROUTER_MAX_CONCURRENT_CHAT_REQUESTS=64

# Diagnostics auth for /health/providers and /metrics: auto | admin | public
# auto = require admin token outside development; open in development/test.
LLM_ROUTER_DIAGNOSTICS_AUTH=auto

# Development-only: allow loopback/private provider base URLs (SSRF policy override).
# Rejected at startup if set outside development/test.
LLM_ROUTER_ALLOW_PRIVATE_PROVIDER_URLS=false

LLM_ROUTER_DEFAULT_TIMEOUT_MS=500
LLM_ROUTER_FAILOVER_BUDGET_MS=500
LLM_ROUTER_CB_FAILURE_THRESHOLD=3
LLM_ROUTER_CB_RECOVERY_TIMEOUT_S=30
LLM_ROUTER_CB_HALF_OPEN_MAX=1
LLM_ROUTER_RATE_CAPACITY=60
LLM_ROUTER_RATE_REFILL_PER_S=1.0
LLM_ROUTER_RATE_COST_PER_REQ=1
LLM_ROUTER_ENABLE_PROMETHEUS=false
LLM_ROUTER_LOG_LEVEL=INFO
LLM_ROUTER_PROVIDER_ORDER=deepseek,openai,anthropic,qwen

# Demo / local API keys (comma-separated). Format: name:key[:provider_id]
# Example forces deepseek for sk-forced-key
LLM_ROUTER_API_KEYS=demo:sk-demo-key,forced:sk-forced-key:deepseek

# Upstream provider credentials (leave empty to disable that provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
