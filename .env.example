# llm-router v0.1 — copy to .env and fill in (never commit .env)

LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=8000
LLM_ROUTER_DB_PATH=./data/llm_router.db
LLM_ROUTER_ADMIN_TOKEN=change-me-admin-token
LLM_ROUTER_DEFAULT_TIMEOUT_MS=500
LLM_ROUTER_FAILOVER_BUDGET_MS=500
LLM_ROUTER_CB_FAILURE_THRESHOLD=3
LLM_ROUTER_CB_RECOVERY_TIMEOUT_S=30
LLM_ROUTER_CB_HALF_OPEN_MAX=1
LLM_ROUTER_RATE_CAPACITY=60
LLM_ROUTER_RATE_REFILL_PER_S=1.0
LLM_ROUTER_RATE_COST_PER_REQ=1
LLM_ROUTER_ENABLE_PROMETHEUS=false
LLM_ROUTER_LOG_LEVEL=INFO
LLM_ROUTER_PROVIDER_ORDER=deepseek,openai,anthropic,qwen

# Demo / local API keys (comma-separated). Format: name:key[:provider_id]
# Example forces deepseek for sk-demo-1
LLM_ROUTER_API_KEYS=demo:sk-demo-key,forced:sk-forced-key:deepseek

# Upstream provider credentials (leave empty to disable that provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
